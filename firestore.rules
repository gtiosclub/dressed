rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validItem(uid, itemId) {
      let item = request.resource.data;
      return item.keys().hasAll(['id', 'ownerId', 'name', 'category', 'imagePath', 'createdAt'])
        && item.keys().hasOnly(['id', 'ownerId', 'name', 'category', 'imagePath', 'createdAt'])
        && item.id == itemId
        && item.ownerId == uid
        && item.name.matches('[\\s\\S]{1,80}')
        && item.category in ['tops', 'pants', 'skirts', 'dresses', 'shoes', 'outerwear', 'accessories', 'other']
        && item.imagePath is string
        && item.imagePath.matches('users/' + uid + '/items/' + itemId + '/original\\.jpg')
        && item.createdAt is timestamp;
    }

    function validOutfit(uid, outfitId) {
      let outfit = request.resource.data;
      return outfit.keys().hasAll(['id', 'schemaVersion', 'ownerId', 'placementSchemaVersion', 'placements', 'createdAt', 'updatedAt'])
        && outfit.keys().hasOnly(['id', 'schemaVersion', 'ownerId', 'name', 'placementSchemaVersion', 'placements', 'createdAt', 'updatedAt'])
        && outfit.id == outfitId && outfit.ownerId == uid
        && outfit.schemaVersion == 1 && outfit.placementSchemaVersion == 1
        && (!('name' in outfit) || (outfit.name is string && outfit.name.size() <= 80))
        && outfit.placements is list && outfit.placements.size() <= 20
        && outfit.createdAt is timestamp && outfit.updatedAt is timestamp;
    }

    function likeCount(data) {
      return 'likeCount' in data ? data.likeCount : 0;
    }

    function validPostLike(uid, postId) {
      let like = request.resource.data;
      return like.keys().hasAll(['id', 'schemaVersion', 'ownerId', 'postId', 'createdAt'])
        && like.keys().hasOnly(['id', 'schemaVersion', 'ownerId', 'postId', 'createdAt'])
        && like.id == postId && like.postId == postId && like.ownerId == uid
        && like.schemaVersion == 1 && like.createdAt is timestamp;
    }

    function validLikeCountTransition(postId) {
      let uid = request.auth.uid;
      let likePath = /databases/$(database)/documents/users/$(uid)/postLikes/$(postId);
      let before = likeCount(resource.data);
      let after = likeCount(request.resource.data);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && after is int && after >= 0
        && ((!exists(likePath) && existsAfter(likePath) && after == before + 1)
          || (exists(likePath) && !existsAfter(likePath) && after == before - 1));
    }

    function validPublishedItem(item, root) {
      return item.keys().hasOnly(['sourceItemId', 'name', 'category', 'mediaPath', 'productURL'])
        && item.sourceItemId.matches('[A-Za-z0-9_-]{1,128}')
        && item.name.matches('[\\s\\S]{1,80}')
        && item.category in ['tops', 'pants', 'skirts', 'dresses', 'shoes', 'outerwear', 'accessories', 'other']
        && item.mediaPath == root + '/items/' + item.sourceItemId + '.jpg'
        && (!('productURL' in item) || (item.productURL is string && item.productURL.matches('https://.+')));
    }

    function validPublishedIndex(items, index, root) {
      let item = items.size() > index ? items[index] : null;
      return items.size() <= index || validPublishedItem(item, root);
    }

    function validPostCreate(postId) {
      let post = request.resource.data;
      let outfit = post.outfitSnapshot;
      let root = 'posts/' + request.auth.uid + '/' + postId;
      return post.keys().hasAll([
          'id', 'schemaVersion', 'authorId', 'caption', 'outfitSnapshot',
          'mediaPath', 'createdAt', 'likeCount'
        ])
        && post.keys().hasOnly([
          'id', 'schemaVersion', 'authorId', 'caption', 'outfitSnapshot',
          'mediaPath', 'createdAt', 'likeCount'
        ])
        && post.id == postId && post.schemaVersion == 1
        && post.authorId == request.auth.uid
        && post.caption is string && post.caption.size() <= 500
        && post.mediaPath == 'posts/' + request.auth.uid + '/' + postId + '/composite.jpg'
        && post.createdAt is timestamp && post.likeCount == 0
        && outfit is map
        && outfit.keys().hasAll(['items'])
        && outfit.keys().hasOnly(['name', 'items'])
        && (!('name' in outfit) || (outfit.name is string && outfit.name.size() <= 80))
        && outfit.items is list && outfit.items.size() > 0 && outfit.items.size() <= 10
        && validPublishedIndex(outfit.items, 0, root)
        && validPublishedIndex(outfit.items, 1, root)
        && validPublishedIndex(outfit.items, 2, root)
        && validPublishedIndex(outfit.items, 3, root)
        && validPublishedIndex(outfit.items, 4, root)
        && validPublishedIndex(outfit.items, 5, root)
        && validPublishedIndex(outfit.items, 6, root)
        && validPublishedIndex(outfit.items, 7, root)
        && validPublishedIndex(outfit.items, 8, root)
        && validPublishedIndex(outfit.items, 9, root);
    }

    function postCountChangesBy(postId, delta) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return exists(postPath) && existsAfter(postPath)
        && likeCount(getAfter(postPath).data) == likeCount(get(postPath).data) + delta;
    }

    match /users/{uid}/items/{itemId} {
      allow get, list: if owns(uid);
      allow create: if owns(uid) && validItem(uid, itemId);
      allow update: if owns(uid)
        && resource.data.id == itemId && resource.data.ownerId == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validItem(uid, itemId);
      allow delete: if owns(uid);
    }

    match /users/{uid}/outfits/{outfitId} {
      allow get, list: if owns(uid);
      allow create: if owns(uid) && validOutfit(uid, outfitId);
      allow update: if owns(uid)
        && resource.data.id == outfitId && resource.data.ownerId == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validOutfit(uid, outfitId);
      allow delete: if owns(uid);
    }

    match /users/{uid}/postLikes/{postId} {
      allow get, list: if owns(uid);
      allow create: if owns(uid)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && validPostLike(uid, postId)
        && postCountChangesBy(postId, 1);
      allow update: if false;
      allow delete: if owns(uid) && postCountChangesBy(postId, -1);
    }

    // Immutable published copies; private closet paths are never valid post media.
    match /posts/{postId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && validPostCreate(postId);
      allow update: if request.auth != null && validLikeCountTransition(postId);
      allow delete: if false;
    }

    // Comments belong only to existing published posts. Reads are bounded;
    // clients cannot impersonate authors, edit records, or revive removed posts.
    match /posts/{postId}/comments/{commentId} {
      function visiblePost() {
        return request.auth != null
          && exists(/databases/$(database)/documents/posts/$(postId));
      }
      function validComment() {
        let comment = request.resource.data;
        return comment.keys().hasAll(['id', 'authorId', 'text', 'createdAt'])
          && comment.keys().hasOnly(['id', 'authorId', 'text', 'createdAt'])
          && comment.id == commentId
          && comment.authorId == request.auth.uid
          && comment.text is string && comment.text.size() <= 1000
          && comment.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && comment.createdAt == request.time;
      }
      allow get: if visiblePost();
      allow list: if visiblePost() && request.query.limit != null && request.query.limit <= 50;
      allow create: if visiblePost() && validComment();
      allow update, delete: if false;
    }

    // Public retailer metadata is curated by the backend, never by client writes.
    match /catalogProducts/{productId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 200;
      allow create, update, delete: if false;
    }

    // Includes the existing uppercase legacy collections and unapproved models.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
